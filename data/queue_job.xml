<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="channel_sii_dte" model="queue.job.channel">
            <field name="name">root.sii_dte</field>
            <field name="parent_id" ref="queue_job.channel_root"/> 
        </record>

        <record id="job_function_sii_cron_procesar" model="queue.job.function">
            <field name="model_id" search="[('model', '=', 'sii.cola_envio')]"/>
            <field name="method">_cron_procesar_cola</field>
            <field name="channel_id" ref="channel_sii_dte"/>
            <field name="retry_pattern" eval="{1: 60, 2: 300, 3: 600}"/>
        </record>

    </data>
</odoo>